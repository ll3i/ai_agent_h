# Saltlux LUXIA PLATFORM API Configuration
# 팀 대시보드에서 배정받은 API 키를 입력하세요
SALTLUX_API_KEY=your_api_key_here
SALTLUX_API_BASE_URL=https://bridge.luxiacloud.com/llm/openai/chat/completions/gpt-4o-mini/create

# Project Configuration
PROJECT_NAME=Manufacturing_AI_Agent
LOG_LEVEL=INFO
DATA_DIR=./data
OUTPUT_DIR=./outputs

# Agent Configuration
MAX_RETRIES=3
CONFIDENCE_THRESHOLD=0.85
BATCH_SIZE=5

# Image Processing
IMAGE_SIZE=224
IMAGE_QUALITY=95
